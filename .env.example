# Copia este archivo a .env. El .env real no se versiona nunca.

PROJECT_NAME=Suite web Screenplay
ENV_WEB=local

# La app de ejemplo que viene en demo/. `npm run demo` la sirve en este puerto.
URL_WEB=http://localhost:4173

# chromium | firefox | webkit
BROWSER_PORTAL=chromium

# false para ver el navegador durante la corrida
BROWSER_NO_VISUAL=true

# Milisegundos de retardo entre acciones. Solo para depurar a ojo.
PW_SLOWMO=0

CUCUMBER_DEFAULT_TIMEOUT=60000

# Credenciales de la app de ejemplo. En un proyecto real estas salen del gestor
# de secretos del CI, nunca de un archivo en el repositorio.
USUARIO_DEMO=demo
CLAVE_DEMO=demo123
